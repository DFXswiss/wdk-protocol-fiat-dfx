# Example application configuration. The library itself does not read environment variables.
# examples/buy.js reads the three variables below.
DFX_ENVIRONMENT=sandbox
DFX_WALLET=
DFX_NETWORK=ethereum

# Unit and integration tests need no environment file. The integration harness
# sets its replay origin internally.

# Optional variables of the probes under e2e/. See e2e/README.md.
# DFX_ENV=sandbox                        # live-matrix.mjs and native-quotes.mjs: sandbox or production
# WALLET_SIM_SEED_FILE=                  # bundler-send.mjs and safe-rescue.mjs, when --seed-file is omitted
