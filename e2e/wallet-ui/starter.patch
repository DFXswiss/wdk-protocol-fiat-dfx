diff --git a/src/app/sell/index.tsx b/src/app/sell/index.tsx
new file mode 100644
index 0000000..a59db62
--- /dev/null
+++ b/src/app/sell/index.tsx
@@ -0,0 +1,95 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { View } from 'react-native';
+import { useRouter } from 'expo-router';
+import { WebView } from 'react-native-webview';
+import { useAccount, useProtocol } from '@tetherto/wdk-react-native-core';
+import { Screen, ScreenHeader, Text, Button, LoadingState } from '@/components';
+import { useAccounts } from '@/state/accounts';
+
+/**
+ * 1 USDT in base units (6 decimals). Passed as a number because the worklet
+ * bridge serializes bigint as a string, and the fiat module rejects a string
+ * amount. 1000000 is a safe integer.
+ */
+const ONE_USDT_BASE_UNITS = 1000000;
+
+type SellCaller = {
+  sell: (options: {
+    cryptoAsset: string;
+    fiatCurrency: string;
+    cryptoAmount: number;
+    config?: { network?: string };
+  }) => Promise<{ sellUrl?: string } | undefined>;
+};
+
+function sellErrorText(error: unknown): string {
+  let message = '';
+  if (error instanceof Error) message = error.message;
+  else if (typeof error === 'string') message = error;
+  else if (error && typeof error === 'object' && 'message' in error && typeof error.message === 'string') {
+    message = error.message;
+  }
+  const trimmed = message.trim();
+  if (!trimmed || /session=/i.test(trimmed) || /https?:\/\//i.test(trimmed)) return 'Sell failed';
+  return trimmed;
+}
+
+export default function SellScreen() {
+  const router = useRouter();
+  const activeIndex = useAccounts((s) => s.activeIndex);
+  const wallet = useAccount({ network: 'ethereum', accountIndex: activeIndex });
+  const dfx = useProtocol<SellCaller>({
+    network: 'ethereum',
+    accountIndex: activeIndex,
+    protocolType: 'fiat',
+    protocolName: 'dfx',
+  });
+  const started = useRef(false);
+  const [sellUrl, setSellUrl] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    if (!wallet.address || started.current) return;
+    started.current = true;
+    dfx.sell({
+      cryptoAsset: 'USDT',
+      fiatCurrency: 'EUR',
+      cryptoAmount: ONE_USDT_BASE_UNITS,
+      config: { network: 'Sepolia' },
+    }).then((result) => {
+      const url = typeof result?.sellUrl === 'string' ? result.sellUrl : '';
+      if (!url) {
+        setError('Sell returned no URL');
+        return;
+      }
+      setSellUrl(url);
+    }).catch((caught: unknown) => {
+      setError(sellErrorText(caught));
+    });
+  }, [wallet.address, dfx]);
+
+  const done = () => {
+    router.dismissTo('/(app)/(tabs)/wallet');
+  };
+
+  return (
+    <Screen edges={['top', 'bottom']}>
+      <ScreenHeader title="Sell" onBack={done} />
+      <View style={{ flex: 1 }}>
+        {error ? (
+          <Text testID="sell-error" variant="body" color="error">{error}</Text>
+        ) : null}
+        {sellUrl ? (
+          <WebView
+            testID="sell-webview"
+            source={{ uri: sellUrl }}
+            style={{ flex: 1 }}
+          />
+        ) : !error ? (
+          <LoadingState message="Opening sell" />
+        ) : null}
+      </View>
+      <Button testID="sell-done" label="Done" onPress={done} />
+    </Screen>
+  );
+}
